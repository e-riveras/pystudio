Screen {
    layout: vertical;
}

#body {
    layout: horizontal;
    height: 1fr;
}

#agent {
    width: 40%;
    height: 100%;
    border: round $surface-lighten-2;
    border-title-color: $text-muted;
    border-title-align: left;
    display: none;
}

#agent:focus {
    border: round $accent;
    border-title-color: $accent;
}

#panes {
    height: 100%;
    width: 1fr;
}

/* The shares of #left, #right and the panes in them are set by Panes. */
#left, #right {
    height: 100%;
}

#dock {
    width: 100%;
}

#editor, #console, #assistant, #variables, #plots {
    border: round $surface-lighten-2;
    border-title-color: $text-muted;
    border-title-align: left;
    width: 100%;
    padding: 0;
}

#console, #assistant {
    height: 100%;
}

#editor:focus, #variables:focus, #plots:focus, #console:focus-within, #assistant:focus-within {
    border: round $accent;
    border-title-color: $accent;
}
